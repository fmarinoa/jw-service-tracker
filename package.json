{
  "name": "jw-service-tracker",
  "version": "0.2.0",
  "private": true,
  "description": "Monorepo for JW Service Tracker",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "prettier": "pnpm run -r prettier",
    "cli": "pnpm --filter jw-cli start",
    "commit": "sh -c 'git add . && git commit -m \"$(agy -p \"Generate a concise conventional commit message based on this diff, response only in text format, without any extra text or markdown: $(git diff --staged)\")\"'"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/luxon": "3.7.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
