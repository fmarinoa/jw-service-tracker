  "info": {
    "title": "JW Service Tracker API",
    "description": "API documentation for the JW Service Tracker application",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://jw-service-tracker.vercel.app",
      "description": "Production server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Bearer token authentication"
      }
    },
    "schemas": {
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "preacherType": {
            "type": "string",
            "enum": [
              "regular_pioneer",
              "auxiliary_pioneer",
              "publisher"
            ],
            "description": "Preacher type classification",
            "example": "pioneer"
          },
          "monthlyGoal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Monthly preaching hours goal",
            "example": 100
          },
          "showTutorial": {
            "type": "boolean",
            "description": "Whether to show tutorial on next login",
            "example": false
          }
        }
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "description": "Phone number with country code",
            "example": "+51912345678"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "User password",
            "example": "password123"
          },
          "platform": {
            "type": "string",
            "description": "Platform identifier",
            "example": "web"
          },
          "deviceName": {
            "type": "string",
            "description": "Device name for session tracking",
            "example": "iPhone 12"
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "description": "Refresh token for obtaining a new access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "description": "User full name",
            "example": "Juan Pérez"
          },
          "phone": {
            "type": "string",
            "pattern": "^9\\d{8}$",
            "description": "Peruvian mobile phone number (9 digits starting with 9)",
            "example": "912345678"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "User password",
            "example": "SecurePassword123"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "User email address",
            "example": "jw@example.com"
          },
          "invitationCode": {
            "type": "string",
            "description": "Invitation code for registration",
            "example": "INV123456"
          }
        },
        "required": [
          "name",
          "phone",
          "password"
        ]
      },
      "CreateEntryDto": {
        "type": "object",
        "properties": {
          "preachingDate": {
            "type": "number",
            "description": "Preaching date as Unix timestamp (milliseconds)",
            "example": 1719446400000
          },
          "hours": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24,
            "description": "Hours spent in preaching activity (0-24)",
            "example": 2
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Minutes spent in preaching activity (0-59)",
            "example": 30
          },
          "type": {
            "type": "string",
            "enum": [
              "house_to_house",
              "revisits",
              "bible_study",
              "other"
            ],
            "description": "Type of preaching session",
            "example": "house_to_house"
          },
          "notes": {
            "type": "string",
            "maxLength": 50,
            "description": "Optional notes about the session",
            "example": "Good conversation"
          },
          "tempId": {
            "type": "string",
            "description": "Temporary ID for offline sync",
            "example": "temp_123abc"
          }
        },
        "required": [
          "preachingDate",
          "hours",
          "minutes",
          "type"
        ]
      },
      "UpdateEntryDto": {
        "type": "object",
        "properties": {
          "preachingDate": {
            "type": "number",
            "description": "Preaching date as Unix timestamp (milliseconds)",
            "example": 1719446400000
          },
          "hours": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24,
            "description": "Hours spent in preaching activity (0-24)",
            "example": 2
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Minutes spent in preaching activity (0-59)",
            "example": 30
          },
          "type": {
            "type": "string",
            "enum": [
              "house_to_house",
              "revisits",
              "bible_study",
              "other"
            ],
            "description": "Type of preaching session",
            "example": "house_to_house"
          },
          "notes": {
            "type": "string",
            "maxLength": 50,
            "description": "Optional notes about the session",
            "example": "Good conversation"
          },
          "tempId": {
            "type": "string",
            "description": "Temporary ID for offline sync",
            "example": "temp_123abc"
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the entry",
            "example": "507f1f77bcf86cd799439011"
          }
        },
        "required": [
          "preachingDate",
          "hours",
          "minutes",
          "type",
          "id"
        ]
      }
    }
  }
}