{
  "name": "jw-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI tool for managing JW Service Tracker data",
  "main": "dist/index.js",
  "bin": {
    "jw-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@jw-tracker/shared": "workspace:*",
    "commander": "15.0.0",
    "luxon": "3.7.2",
    "mongodb": "7.5.0",
    "picocolors": "1.1.1",
    "smol-toml": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/luxon": "3.7.2",
    "tsx": "4.23.1"
  }
}
