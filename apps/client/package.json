{
  "name": "@jw-tracker/client",
  "version": "0.0.2",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start -c",
    "build": "expo export --platform web",
    "lint": "eslint . --fix",
    "prettier": "prettier --write .",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "android:release": "expo run:android --device --variant release --no-bundler",
    "ios:release": "expo run:ios --device --configuration Release --no-bundler",
    "xcode": "expo prebuild --platform ios && open ios/JWServiceTracker.xcworkspace"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@jw-tracker/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "54.0.36",
    "expo-asset": "12.0.13",
    "expo-constants": "18.0.13",
    "expo-linking": "8.0.12",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "luxon": "3.7.2",
    "nativewind": "4.2.6",
    "postcss": "8.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.22.15",
    "@babel/runtime": "7.25.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "babel-preset-expo": "54.0.12",
    "pretty-format": "30.4.1"
  }
}
