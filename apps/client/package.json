{
  "name": "@jw-tracker/client",
  "version": "0.0.5",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start -c",
    "build": "expo export --platform web && mkdir -p dist/app && cp -r dist/_expo dist/assets dist/index.html dist/app/",
    "lint": "eslint . --fix",
    "prettier": "prettier --write .",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "apk": "pnpm --filter @jw-tracker/shared build && expo prebuild --platform android && printf '\\norg.gradle.jvmargs=-Xmx3072m -XX:MaxMetaspaceSize=1024m -XX:+UseG1GC\\n' >> android/gradle.properties && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a --build-cache --max-workers=4",
    "android:release": "expo run:android --device --variant release --no-bundler",
    "ios:release": "expo run:ios --device --configuration Release --no-bundler",
    "xcode": "expo prebuild --platform ios && open ios/JWServiceTracker.xcworkspace"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.7",
    "@jw-tracker/shared": "workspace:*",
    "@jw-tracker/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "57.0.8",
    "expo-asset": "57.0.7",
    "expo-constants": "57.0.7",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "nativewind": "4.2.6",
    "postcss": "8.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.11.2",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@babel/runtime": "8.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-preset-expo": "57.0.4",
    "pretty-format": "30.4.1"
  }
}
