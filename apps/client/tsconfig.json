{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "app/**/*", "nativewind-env.d.ts"],
  "extends": "expo/tsconfig.base"
}
