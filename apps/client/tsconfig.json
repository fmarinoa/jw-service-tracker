{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "types": ["node"],
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "paths": {
      "@jw-tracker/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "app/**/*", "nativewind-env.d.ts"],
  "extends": "expo/tsconfig.base"
}
