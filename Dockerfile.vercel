# Stage 1: Build stage
FROM node:24-alpine AS builder

# Install pnpm globally
RUN npm install -g pnpm

WORKDIR /app

# Copy pnpm and workspace configs
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/

# Install dependencies (including devDependencies needed for compiling)
RUN pnpm install --filter api... --frozen-lockfile

# Copy shared package and build it
COPY packages/shared ./packages/shared
RUN pnpm --filter @jw-tracker/shared build

# Copy api code
COPY apps/api ./apps/api

# Build NestJS API (outputs to apps/api/dist)
RUN pnpm --filter api build

# Produce a self-contained production node_modules for apps/api, resolved from
# its package.json/lockfile. Single source of truth for runtime deps that webpack.config.js
# keeps external (e.g. bcrypt, swagger-ui-dist) — no manual version pinning here.
RUN pnpm --filter api deploy --prod --legacy /app/deploy

# Stage 2: Production runtime stage
FROM node:24-alpine AS runner

WORKDIR /app

# Copy built code from the builder stage (webpack bundle)
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy the deployed production node_modules (built on the same alpine/node image,
# so native modules like bcrypt already match the runtime arch/ABI)
COPY --from=builder /app/deploy/node_modules ./node_modules

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["node", "apps/api/dist/main.js"]
