{
  "services": {
    "frontend": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    },
    "backend": {
      "root": ".",
      "entrypoint": "Containerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
