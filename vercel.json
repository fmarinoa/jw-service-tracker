{
  "services": {
    "frontend": {
      "root": "apps/client/",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist",
      "routes": [
        {
          "src": "/([^.]*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        }
      ]
    },
    "backend": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
