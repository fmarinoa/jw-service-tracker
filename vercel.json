{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "buildCommand": "pnpm --filter @jw-tracker/shared build && pnpm --filter @jw-tracker/ui build && pnpm build",
      "outputDirectory": "dist"
    },
    "frontend": {
      "root": "apps/client/",
      "buildCommand": "pnpm --filter @jw-tracker/shared build && pnpm --filter @jw-tracker/ui build && pnpm build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/app",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
