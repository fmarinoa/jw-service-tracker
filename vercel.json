{
  "buildCommand": "pnpm run -r build && node scripts/prepare-vercel-output.js",
  "outputDirectory": ".vercel/output/static",
  "services": {
    "backend": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/((?!api|app|assets|_expo).*)*",
      "destination": "/index.html"
    }
  ]
}
