{
  "buildCommand": "pnpm run -r build && node scripts/prepare-vercel-output.js",
  "outputDirectory": ".vercel/output/static",
  "services": {
    "backend": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/_expo/:path*",
      "destination": "/app/_expo/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.:domain*"
        }
      ],
      "destination": "/app/:path*"
    },
    {
      "source": "/((?!api|assets|_expo|app).*)*",
      "destination": "/index.html"
    }
  ]
}
