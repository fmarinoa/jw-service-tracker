{
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    },
    "files.associations": { "*.html.template": "html" },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/android/**": true,
        "**/ios/**": true,
        "**/.expo/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/android": true,
        "**/ios": true,
        "**/.agents": true,
        "pnpm-lock.yaml": true,
    }
}
